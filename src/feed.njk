---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>YanaLabs — Automatisation No-Code &amp; IA</title>
    <description>Le blog de l'automatisation pour les TPE et PME : Make, Airtable, IA et productivité.</description>
    <link>https://yanalabs.fr/</link>
    <atom:link href="https://yanalabs.fr/feed.xml" rel="self" type="application/rss+xml"/>
    <language>fr-fr</language>
    <lastBuildDate>{{ now | dateToRfc822 }}</lastBuildDate>
    
    {%- for post in collections.articles | reverse %}
      {# On n'inclut que les articles dont la date est passée ou présente #}
      {%- if post.date <= now -%}
      <item>
        <title>{{ post.data.title }}</title>
        <link>https://yanalabs.fr{{ post.url }}</link>
        <description>{{ post.data.description }}</description>
        <pubDate>{{ post.date | dateToRfc822 }}</pubDate>
        <guid>https://yanalabs.fr{{ post.url }}</guid>
      </item>
      {%- endif -%}
    {%- endfor %}
  </channel>
</rss>
